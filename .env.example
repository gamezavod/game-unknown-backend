DATABASE_URL=postgresql+psycopg://gamezavod:CHANGE_ME@localhost:5432/gamezavod
POSTGRES_USER=gamezavod
POSTGRES_DB=gamezavod
POSTGRES_PASSWORD=
JWT_SECRET=
JWT_ALGORITHM=HS256
JWT_ISSUER=gamezavod
JWT_AUDIENCE=gamezavod-api
ACCESS_TTL_SECONDS=900
REFRESH_TTL_SECONDS=2592000
LOGIN_MAX_ATTEMPTS=5
LOGIN_WINDOW_SECONDS=300
# Compose host ports (internal ports remain 5432 and 8000).
POSTGRES_PORT=5432
API_PORT=8000
